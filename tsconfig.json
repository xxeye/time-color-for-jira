{
  // Type check only: nothing is emitted and the extension ships the original .js files (see pack.py).
  // Every included .js file is checked in strict mode; a new file is checked as soon as it matches `include`.
  // Files still start with `// @ts-check`: tsc 7.0.2 reports duplicate identifiers when the first comment is `@import`.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    // popup.js and options.js run on different pages but both declare `t` and `$` at the top level.
    "moduleDetection": "force",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "types": ["chrome"],
    "resolveJsonModule": true
  },
  "include": ["*.js", "config-generator/generator.js", "types/**/*.d.ts", "type-tests/**/*.ts"]
}
